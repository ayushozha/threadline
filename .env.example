# Copy to .env and fill locally. Never commit .env or real credentials.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ACCESS_TOKEN=
# Automatic bounded browser sessions; public deployments require an exact origin.
APP_GUEST_SESSIONS=
APP_PUBLIC_ORIGIN=
# Local laptop only: 1 lets requests from this machine to localhost skip the token. Never on a server.
APP_TRUST_LOOPBACK=

# Required for live evidence-backed responses. Choose a model available to your key.
GOOGLE_API_KEY=
# Talk to Threadline over OpenAI Realtime (speech to speech, Vexo band input). Optional.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GEMINI_MODEL=gemini-4-hydrogen
# Gemini Decisions API model for the agent's choices (https://aistudio.google.com/docs/decisions-api).
GEMINI_DECISION_MODEL=gemini-decision-1
# Gemini Live (spoken memory support, /api/live-gemini). Any model your key lists with bidiGenerateContent:
# https://ai.google.dev/gemini-api/docs/live
GEMINI_LIVE_MODEL=gemini-3.8-live

# Required for audio transcription. Text-only use does not need Deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=100
DEEPGRAM_DIARIZE_MODEL=latest

# Separate demo narration assets (not in-app speech playback).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Optional in-app voice overrides. Without them the configured ElevenLabs voice/model are used.
ASSISTANT_VOICE_ID=
ASSISTANT_MULTILINGUAL_MODEL=
NARRATION_STABILITY=0.3
NARRATION_SIMILARITY=0.65
NARRATION_STYLE=0.1
NARRATION_SPEED=0.96
# MiniMax music generation (https://platform.minimax.io/docs/api-reference/music-generation).
# Docs note: paid music APIs closed to new users from 2026-08-20; free-tier models discontinued.
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0
# Optional illustrative presenter video generation; never used for app evidence.
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
# Optional; defaults to https://api.minimax.io (mainland China accounts: https://api.minimaxi.com).
MINIMAX_API_BASE=

MINIMAX_IMAGE_MODEL_FILE=minimax_h3_image_pruned_w4a8.safetensors
MINIMAX_TEXT_ENCODER_FILE=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
MINIMAX_IMAGE_VAE_FILE=minimax_h3_image_vae_fp16.safetensors

# Existing local image runtime; use absolute paths. See docs/demo/LOCAL_IMAGE_RUNTIME.md
PYTHON_RUNTIME=
COMFYUI_DIR=
MINIMAX_TEXT_ENCODER_DIR=
LOCAL_COMFY_URL=http://127.0.0.1:8188

# Your team's assigned Vexo band number (1-999). Never another team's band.
VEXO_BAND_NUMBER=73
